
import os
import httpx
from mcp.server.fastmcp import FastMCP, Image

mcp = FastMCP("灵灵的表情包")

@mcp.tool()
async def send_sticker(name: str = "抱抱") -> Image:
    """发送抱抱表情包。"""
    if name != "抱抱":
        raise ValueError("目前只支持抱抱")
    url = "https://cdn.jsdelivr.net/gh/linmoc39/OpenDroidChat@main/app/src/main/res/drawable/01_%E6%8A%B1%E6%8A%B1.png"
    async with httpx.AsyncClient(timeout=20) as client:
        response = await client.get(url)
        response.raise_for_status()
        return Image(data=response.content, mimeType="image/png")

if __name__ == "__main__":
    mcp.run(transport="streamable-http", host="0.0.0.0", port=int(os.environ.get("PORT", "8000")))
